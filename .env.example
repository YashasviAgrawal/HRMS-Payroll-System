# Copy to .env and fill in. Generate keys with:  openssl rand -base64 32
DATABASE_URL="postgresql://hrms:hrms@localhost:5432/hrms_dev"
# Only when DATABASE_URL goes through a connection pooler: the direct address, used by migrations and the seed.
# DIRECT_DATABASE_URL=""
# Used only by the integration tests (a separate, throw-away database).
TEST_DATABASE_URL="postgresql://hrms:hrms@localhost:5432/hrms_test"
# development | test | training | production (PRD §16: separate production, test and training copies).
APP_ENV="development"
# Used only by the browser checks (rebuilt and re-seeded on every run).
E2E_DATABASE_URL="postgresql://hrms:hrms@localhost:5432/hrms_e2e"
APP_URL="http://localhost:3000"
# The Board this installation serves (multi-Board ready, PRD §16).
BOARD_CODE="DCB"
# AES-256-GCM key for Aadhaar, PAN and bank account (32 bytes, base64).
DATA_ENCRYPTION_KEY=""
# HMAC key used to detect duplicates without decrypting (32 bytes, base64).
BLIND_INDEX_KEY=""
# Extra secret mixed into OTP hashes (32 bytes, base64).
OTP_PEPPER=""
# console = OTPs and messages printed to the server log (development only); http = real gateway.
SMS_PROVIDER="console"
# Where uploaded documents and generated files are kept.
STORAGE_DIR="./storage"
# Optional: path to Chromium for PDF generation (payslips, PPO, pay bill).
# CHROMIUM_PATH="/usr/bin/chromium"
# Reverse proxies in front of the app that add to X-Forwarded-For (nginx alone = 1). The client address in the
# audit trail and the rate limits is read from that entry, never from a value the browser sent.
TRUSTED_PROXY_HOPS="1"
