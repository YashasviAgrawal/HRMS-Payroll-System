// DCB HRMS & Payroll — database schema.
// Every business table carries boardId so other Cantonment Boards can be added later (PRD §16, §17).
// Module 1 (foundation) tables live at the top; each later module adds its own block below.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Module 1 — Foundation
// ─────────────────────────────────────────────────────────────────────────────

/// The three logins of PRD §2.
enum LoginType {
  ADMIN
  HR_ACCOUNTS
  EMPLOYEE
}

/// Permissions an Admin can tick inside a login (PRD §2).
enum Permission {
  APPROVER
  PAY_BILL_SIGNER
  USER_SETTINGS_MANAGER
  HR
  PAYROLL
  PENSION
  CHECKER
  REPORTING_OFFICER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model Board {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  nameHi    String
  address   String?
  createdAt DateTime @default(now())

  sections Section[]
  posts    Post[]
  users    User[]
}

model Section {
  id             String         @id @default(cuid())
  boardId        String
  code           String
  name           String
  nameHi         String
  isActive       Boolean        @default(true)
  /// DEVICE = biometric punches (AT-01); MANUAL = muster entered by HR (AT-02).
  attendanceMode AttendanceMode @default(DEVICE)
  /// Weekly off days as "0,6" (0 = Sunday … 6 = Saturday). Null follows the Board setting.
  weeklyOff      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  board     Board      @relation(fields: [boardId], references: [id])
  employees Employee[]

  @@unique([boardId, code])
}

/// A post (designation) such as "Junior Clerk". Retirement age follows the post's rule (EM-02).
model Post {
  id            String   @id @default(cuid())
  boardId       String
  code          String
  name          String
  nameHi        String
  payLevel      String
  group         String // A, B or C
  retirementAge Int      @default(60)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  board     Board      @relation(fields: [boardId], references: [id])
  employees Employee[]

  @@unique([boardId, code])
}

enum EmployeeType {
  PERMANENT_OPS
  PERMANENT_NPS
  CONTRACT
  DAILY_WAGE
  REEMPLOYED
  DEPUTATION
}

enum EmployeeStatus {
  /// Entered by HR, waiting for the Checker; gets its Employee ID on approval.
  DRAFT
  ACTIVE
  SUSPENDED
  RETIRED
  RESIGNED
  TRANSFERRED
  TERMINATED
  DECEASED
}

/// One record per person (EM-01). Every other module reads from it.
model Employee {
  id               String         @id @default(cuid())
  boardId          String
  /// Null while the record is a draft; issued when the Checker approves (RO flow step 4).
  employeeCode     String?
  type             EmployeeType
  status           EmployeeStatus @default(ACTIVE)
  firstName        String
  middleName       String?
  lastName         String?
  nameHi           String?
  gender           String // M, F, T
  dateOfBirth      DateTime       @db.Date
  dateOfJoining    DateTime       @db.Date
  dateOfRetirement DateTime?      @db.Date
  /// Set when the person leaves for any reason; access ends on this date (PRD §2 rule 6).
  exitDate         DateTime?      @db.Date
  exitReason       String?
  sectionId        String
  postId           String
  payLevel         String?
  payCell          Int?
  /// 1 (January) or 7 (July): the annual increment date (PR-06). Empty means worked out from the date of joining.
  incrementMonth   Int?
  mobile           String?
  email            String?

  // Personal (Personal tab)
  fatherOrSpouseName String?
  category           String? // GEN, OBC, SC, ST, EWS
  maritalStatus      String? // SINGLE, MARRIED, WIDOWED, DIVORCED
  bloodGroup         String?
  isDisabled         Boolean @default(false)
  /// { line1, line2, city, district, state, pincode } — state and district follow government code lists (PRD §12 rule 6).
  presentAddress     Json?
  permanentAddress   Json?

  // Identity and bank (EM-03). Aadhaar, PAN and bank account are encrypted; *Hash finds duplicates; *Last4 is for display.
  panEnc           String?
  panHash          String?
  panLast4         String?
  aadhaarEnc       String?
  aadhaarHash      String?
  aadhaarLast4     String?
  pran             String?
  uan              String?
  esicNumber       String?
  gpfNumber        String?
  bankAccountEnc   String?
  bankAccountHash  String?
  bankAccountLast4 String?
  ifsc             String?
  bankName         String?
  bankBranch       String?

  // Probation and confirmation (RO-08)
  probationEndDate DateTime? @db.Date
  confirmationDate DateTime? @db.Date

  /// Enrolment number on the biometric devices / AEBAS attendance ID (AT-01).
  biometricId String?

  // Contract and daily-wage workers (RO-09)
  agencyName    String?
  wageRate      Decimal?  @db.Decimal(12, 2)
  wageBasis     String? // MONTHLY or DAILY
  contractStart DateTime? @db.Date
  contractEnd   DateTime? @db.Date

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  section         Section                @relation(fields: [sectionId], references: [id])
  post            Post                   @relation(fields: [postId], references: [id])
  users           User[]
  family          FamilyMember[]
  nominees        Nominee[]
  documents       EmployeeDocument[]
  serviceBook     ServiceBookEntry[]
  history         EmployeeFieldHistory[]
  payslips        Payslip[]
  payHistory      PayHistory[]
  loans           Loan[]
  gpfEntries      GpfEntry[]
  gpfAdvances     GpfAdvance[]
  taxDeclarations TaxDeclaration[]
  taxCarryIns     TaxCarryIn[]
  pensions        Pensioner[]
  pensionCases    PensionCase[]
  form16          Form16[]
  verification    RecordVerification?

  @@unique([boardId, employeeCode])
  @@unique([boardId, biometricId])
  @@index([boardId, sectionId])
  @@index([boardId, status])
  @@index([boardId, panHash])
  @@index([boardId, aadhaarHash])
  @@index([boardId, bankAccountHash])
}

/// A login. A person may hold one login of each type (for example an HR clerk also has an Employee login
/// for their own payslip), so the login type is part of the identity.
model User {
  id                 String       @id @default(cuid())
  boardId            String
  loginType          LoginType
  /// Employee ID for staff; a short code for people who are not on the rolls (for example "IT01").
  loginId            String
  displayName        String
  displayNameHi      String?
  mobile             String
  email              String?
  passwordHash       String?
  mustChangePassword Boolean      @default(true)
  permissions        Permission[]
  status             UserStatus   @default(ACTIVE)
  language           String       @default("en")
  employeeId         String?
  /// A family pensioner's login, who has no employee record of their own (PN-12).
  pensionerId        String?
  failedLoginCount   Int          @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdById        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  board     Board          @relation(fields: [boardId], references: [id])
  employee  Employee?      @relation(fields: [employeeId], references: [id])
  pensioner Pensioner?     @relation(fields: [pensionerId], references: [id])
  sessions  Session[]
  otps      OtpChallenge[]

  @@unique([boardId, loginType, loginId])
  @@unique([boardId, loginType, mobile])
  @@unique([employeeId, loginType])
}

model Session {
  /// SHA-256 of the random token held in the cookie; the raw token is never stored.
  id         String    @id
  userId     String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum OtpPurpose {
  LOGIN
  CHANGE_MOBILE
  APPROVE_SIGN
}

model OtpChallenge {
  id          String     @id @default(cuid())
  userId      String?
  purpose     OtpPurpose
  codeHash    String
  sentTo      String
  context     Json?
  attempts    Int        @default(0)
  resendCount Int        @default(0)
  lastSentAt  DateTime   @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())
  ip          String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

enum AuditCategory {
  /// Logins, users, permissions and settings — the only events the User & settings manager may see.
  SYSTEM
  /// Employee, pay, leave and everything else.
  DATA
}

/// Every create, edit, approve and print with user, time, IP, old and new value (PRD §11, §16).
/// Rows cannot be updated or deleted: a database trigger blocks it.
model AuditLog {
  id          BigInt        @id @default(autoincrement())
  boardId     String
  at          DateTime      @default(now())
  userId      String?
  userName    String?
  loginType   LoginType?
  action      String
  entityType  String
  entityId    String?
  summary     String
  category    AuditCategory @default(DATA)
  isSensitive Boolean       @default(false)
  ip          String?
  userAgent   String?
  oldValue    Json?
  newValue    Json?

  @@index([boardId, at])
  @@index([boardId, entityType, entityId])
  @@index([boardId, userId])
}

/// Every approved change writes an event here so later systems can subscribe (PRD §12 rule 5).
model OutboxEvent {
  id            BigInt    @id @default(autoincrement())
  boardId       String
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)

  @@index([publishedAt, id])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

/// The maker-checker engine. One row per item waiting for a decision (S-04 Approvals inbox).
model ApprovalTask {
  id                 String         @id @default(cuid())
  boardId            String
  kind               String
  title              String
  titleHi            String?
  details            Json?
  payload            Json
  requiredPermission Permission
  /// Limits the task to reporting officers of this section.
  sectionId          String?
  /// Whose record, pay, loan or arrears this is; that person can never decide it (PRD §2 rule 2).
  subjectEmployeeId  String?
  entityType         String
  entityId           String?
  status             ApprovalStatus @default(PENDING)
  makerId            String
  makerName          String
  makerNote          String?
  deciderId          String?
  deciderName        String?
  decisionNote       String?
  decidedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([boardId, status, requiredPermission])
  @@index([boardId, entityType, entityId])
}

model Setting {
  boardId     String
  key         String
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@id([boardId, key])
}

/// Running numbers (Employee ID, order numbers…), allocated inside the same transaction as the record.
model Sequence {
  boardId String
  name    String
  next    Int    @default(1)

  @@id([boardId, name])
}

enum FileDirection {
  OUTGOING
  INCOMING
}

enum FileStatus {
  PREVIEW
  APPROVED
  REJECTED
  DOWNLOADED
  VALIDATED
  INVALID
  APPLIED
}

/// Every file the system builds or receives. Outgoing files are previewed, approved by an Admin and
/// logged with a checksum (PRD §12 rule 2, ST-09); incoming files are validated first (rule 3).
model FileRecord {
  id             String        @id @default(cuid())
  boardId        String
  direction      FileDirection
  kind           String
  period         String?
  fileName       String
  mimeType       String
  size           Int
  sha256         String
  storageKey     String
  status         FileStatus
  meta           Json?
  createdById    String
  createdByName  String
  approvedById   String?
  approvedAt     DateTime?
  downloadCount  Int           @default(0)
  lastDownloadAt DateTime?
  createdAt      DateTime      @default(now())

  @@index([boardId, kind, period])
}

enum MessageChannel {
  SMS
  EMAIL
}

model MessageLog {
  id          String         @id @default(cuid())
  boardId     String
  channel     MessageChannel
  recipient   String
  template    String
  /// Message text with any OTP replaced by ******.
  body        String
  status      String
  providerRef String?
  error       String?
  createdAt   DateTime       @default(now())

  @@index([boardId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Module 2 — Employee master
// ─────────────────────────────────────────────────────────────────────────────

model FamilyMember {
  id          String    @id @default(cuid())
  employeeId  String
  name        String
  nameHi      String?
  relation    String // SPOUSE, SON, DAUGHTER, FATHER, MOTHER, BROTHER, SISTER, OTHER
  gender      String?
  dateOfBirth DateTime? @db.Date
  isDependent Boolean   @default(false)
  isDisabled  Boolean   @default(false)
  isAlive     Boolean   @default(true)
  createdAt   DateTime  @default(now())

  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  nominees Nominee[]

  @@index([employeeId])
}

enum NomineeScheme {
  GPF
  GRATUITY
  GROUP_INSURANCE
  FAMILY_PENSION
  NPS
}

/// Nominees per scheme (EM-04). Shares of one scheme add up to 100%.
model Nominee {
  id             String        @id @default(cuid())
  employeeId     String
  scheme         NomineeScheme
  familyMemberId String
  sharePercent   Decimal       @db.Decimal(5, 2)
  createdAt      DateTime      @default(now())

  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  familyMember FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  @@index([employeeId, scheme])
}

/// Uploaded documents (EM-05): PDF or image, up to 5 MB, with checksum.
model EmployeeDocument {
  id             String    @id @default(cuid())
  employeeId     String
  category       String // APPOINTMENT_ORDER, CERTIFICATE, ID_PROOF, SERVICE_ORDER, MEDICAL, PHOTO, OTHER
  title          String
  fileName       String
  mimeType       String
  size           Int
  sha256         String
  storageKey     String
  uploadedById   String
  uploadedByName String
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

enum ServiceEvent {
  APPOINTMENT
  CONFIRMATION
  INCREMENT
  PROMOTION
  MACP
  PAY_FIXATION
  TRANSFER
  LEAVE
  PENALTY
  REWARD
  RETIREMENT
  OTHER
}

enum EntryStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Simple e-service book (EM-06): a dated list of events with order number, date and the attached order.
model ServiceBookEntry {
  id           String       @id @default(cuid())
  employeeId   String
  event        ServiceEvent
  eventDate    DateTime     @db.Date
  orderNumber  String?
  orderDate    DateTime?    @db.Date
  details      String
  detailsHi    String?
  /// Structured data some events carry, e.g. { fromLevel, fromCell, toLevel, toCell } for an increment.
  data         Json?
  documentId   String?
  status       EntryStatus  @default(PENDING)
  createdById  String
  approvedById String?
  createdAt    DateTime     @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, eventDate])
}

/// Old and new value of every approved change to an employee record ("keep their old value in history").
model EmployeeFieldHistory {
  id           String   @id @default(cuid())
  employeeId   String
  field        String
  /// Masked for Aadhaar, PAN and bank account.
  oldValue     String?
  newValue     String?
  isSensitive  Boolean  @default(false)
  changedById  String?
  changedBy    String?
  approvedById String?
  approvedBy   String?
  taskId       String?
  createdAt    DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt])
}

/// Sanctioned strength per section and post (EM-09). Filled = active employees on that post.
model SanctionedPost {
  id          String   @id @default(cuid())
  boardId     String
  sectionId   String
  postId      String
  sanctioned  Int
  orderRef    String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([boardId, sectionId, postId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Module 3 — Recruitment and onboarding
// ─────────────────────────────────────────────────────────────────────────────

enum VacancyStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ADVERTISED
  CLOSED
  CANCELLED
  REJECTED
}

enum SelectionStatus {
  OPEN
  PENDING_APPROVAL
  APPROVED
}

/// A vacancy is created only against a vacant sanctioned post and approved by an Admin before it is advertised (RO-01, RO-02).
model Vacancy {
  id              String          @id @default(cuid())
  boardId         String
  referenceNo     String
  sectionId       String
  postId          String
  payLevel        String
  seats           Int
  /// Reservation break-up { GEN, OBC, SC, ST, EWS } — seats per category (RO-02).
  reservation     Json
  advertNumber    String?
  advertDate      DateTime?       @db.Date
  lastDate        DateTime?       @db.Date
  status          VacancyStatus   @default(DRAFT)
  selectionStatus SelectionStatus @default(OPEN)
  notes           String?
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  applicants Applicant[]
  joinings   Joining[]

  @@unique([boardId, referenceNo])
  @@index([boardId, status])
}

enum ApplicantStatus {
  APPLIED
  ELIGIBLE
  SHORTLISTED
  SELECTED
  WAITLISTED
  REJECTED
}

/// RO-03: applicants added one by one or by Excel import. The exam or interview happens outside; only its result is recorded.
model Applicant {
  id                    String          @id @default(cuid())
  vacancyId             String
  applicationNo         String
  name                  String
  nameHi                String?
  fatherName            String?
  gender                String
  dateOfBirth           DateTime        @db.Date
  category              String
  mobile                String?
  email                 String?
  address               String?
  qualification         String?
  score                 Decimal?        @db.Decimal(7, 2)
  meritRank             Int?
  status                ApplicantStatus @default(APPLIED)
  remarks               String?
  appointmentLetterNo   String?
  appointmentLetterDate DateTime?       @db.Date
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  vacancy Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  joining Joining?

  @@unique([vacancyId, applicationNo])
  @@index([vacancyId, status])
}

enum JoiningStatus {
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  CANCELLED
}

/// RO-05/RO-06/RO-09: turns a selected candidate (or a contract / daily-wage worker hired directly) into an employee.
/// The person's record is a draft employee from the start; "Complete joining" sends it to the Checker.
model Joining {
  id          String        @id @default(cuid())
  boardId     String
  applicantId String?       @unique
  vacancyId   String?
  employeeId  String        @unique
  /// { documents, medical, police, oath, bank, pan, aadhaarConsent } → { done, documentId, note, by, at }
  checklist   Json
  status      JoiningStatus @default(IN_PROGRESS)
  createdById String
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  applicant Applicant? @relation(fields: [applicantId], references: [id])
  vacancy   Vacancy?   @relation(fields: [vacancyId], references: [id])

  @@index([boardId, status])
}

// ─── Module 4: attendance and holidays (PRD §6) ───────────────────────────────

enum AttendanceMode {
  DEVICE
  MANUAL
}

enum HolidayKind {
  GAZETTED
  RESTRICTED
}

/// Holiday calendar (AT-08). Rows exist only for lists a Checker has approved.
model Holiday {
  id        String      @id @default(cuid())
  boardId   String
  date      DateTime    @db.Date
  name      String
  nameHi    String
  kind      HolidayKind
  createdAt DateTime    @default(now())

  @@unique([boardId, date, name])
  @@index([boardId, date])
}

/// Daily status (AT-03). MISSED_PUNCH is provisional; DIES_NON is set only when the officer confirms (AT-05).
enum DayStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  MISSED_PUNCH
  ON_DUTY
  LEAVE
  HOLIDAY
  WEEKLY_OFF
  DIES_NON
}

enum DaySource {
  DEVICE
  MUSTER
  REQUEST
  LOCK
  LEAVE
}

/// One raw punch from a device push or an imported file. Duplicates are ignored by the unique key.
model AttendancePunch {
  id           String   @id @default(cuid())
  boardId      String
  employeeId   String
  at           DateTime
  deviceSerial String?
  importId     String?
  createdAt    DateTime @default(now())

  @@unique([employeeId, at])
  @@index([boardId, at])
}

/// A punch file that was saved (AT-01): who, when, which format, checksum of the stored copy.
model AttendanceImport {
  id             String   @id @default(cuid())
  boardId        String
  format         String
  fileName       String
  storageKey     String
  sha256         String
  rowCount       Int
  savedCount     Int
  duplicateCount Int
  fromDate       DateTime @db.Date
  toDate         DateTime @db.Date
  createdById    String
  createdByName  String
  createdAt      DateTime @default(now())

  @@index([boardId, createdAt])
}

/// The status of one person on one day. Days without a row are worked out from the calendar and punches.
model AttendanceDay {
  id            String    @id @default(cuid())
  boardId       String
  employeeId    String
  date          DateTime  @db.Date
  status        DayStatus
  firstIn       DateTime?
  lastOut       DateTime?
  workedMinutes Int?
  source        DaySource
  /// Leave type when status is LEAVE (filled by the Leave module).
  leaveCode     String?
  /// Half of the day only (half-day leave or half-day dies-non).
  half          Boolean   @default(false)
  note          String?
  /// Manual muster entries and HR corrections wait for a Checker (AT-02).
  checked       Boolean   @default(true)
  /// The leave application that marked this day (LV-04), so cancelling it can undo the day.
  applicationId String?
  updatedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([employeeId, date])
  @@index([boardId, date])
}

enum AttendanceRequestType {
  MISSED_PUNCH
  ON_DUTY
}

/// Missed-punch or on-duty request by an employee (AT-04), decided by the reporting officer.
model AttendanceRequest {
  id          String                @id @default(cuid())
  boardId     String
  employeeId  String
  date        DateTime              @db.Date
  type        AttendanceRequestType
  inTime      String?
  outTime     String?
  reason      String
  status      ApprovalStatus        @default(PENDING)
  taskId      String?
  createdById String
  decidedAt   DateTime?
  createdAt   DateTime              @default(now())

  @@index([boardId, status])
  @@index([employeeId, date])
}

/// A section's month, locked by its reporting officer or HR (AT-05). Payroll reads locked months only.
model AttendanceLock {
  id           String    @id @default(cuid())
  boardId      String
  sectionId    String
  /// "YYYY-MM"
  month        String
  lockedById   String
  lockedByName String
  lockedAt     DateTime  @default(now())
  unlockedAt   DateTime?
  unlockNote   String?

  @@unique([boardId, sectionId, month])
}

/// Month totals per person, frozen at lock; what payroll reads (AT-05, AT-06).
model AttendanceMonth {
  id           String   @id @default(cuid())
  boardId      String
  employeeId   String
  sectionId    String
  month        String
  daysInMonth  Int
  daysOnRoll   Int
  present      Decimal  @db.Decimal(5, 1)
  late         Int
  halfDays     Int
  onDuty       Int
  leave        Decimal  @db.Decimal(5, 1)
  holidays     Int
  weeklyOffs   Int
  diesNon      Decimal  @db.Decimal(5, 1)
  /// Leave on half pay (HPL) and on no pay (EOL) in the month — payroll applies the pay effect (LV-04).
  halfPayLeave Decimal  @default(0) @db.Decimal(5, 1)
  noPayLeave   Decimal  @default(0) @db.Decimal(5, 1)
  /// Days paid for regular staff: days on the rolls less dies-non (and no-pay leave once the Leave module runs).
  payableDays  Decimal  @db.Decimal(5, 1)
  /// Days actually worked — what contract and daily-wage workers are paid for (AT-06).
  workedDays   Decimal  @db.Decimal(5, 1)
  createdAt    DateTime @default(now())

  @@unique([employeeId, month])
  @@index([boardId, month])
}

// ─── Module 5: leave (PRD §7) ───────────────────────────────────────────────────

enum LeavePay {
  FULL
  HALF
  NONE
}

/// HALF_YEARLY: credited on 1 Jan and 1 Jul (EL, HPL). YEARLY: on 1 Jan (CL, RH). SPELL: up to creditDays per
/// spell (maternity, paternity). SERVICE: creditDays in the whole service (CCL). NONE: no balance (EOL, commuted).
enum LeaveCreditMode {
  HALF_YEARLY
  YEARLY
  SPELL
  SERVICE
  NONE
}

/// The leave rules table (LV-01). HR proposes a change, an Admin approves it.
model LeaveType {
  id               String          @id @default(cuid())
  boardId          String
  code             String
  name             String
  nameHi           String
  pay              LeavePay
  creditMode       LeaveCreditMode
  creditDays       Decimal         @default(0) @db.Decimal(6, 1)
  /// Highest balance allowed (EL 300).
  cap              Decimal?        @db.Decimal(6, 1)
  lapsesAtYearEnd  Boolean         @default(false)
  /// Commuted leave is taken from HPL at 2 days per day.
  debitFrom        String?
  debitFactor      Decimal         @default(1) @db.Decimal(3, 1)
  /// Holidays and weekly offs inside the leave are counted (EL, HPL…); not for CL.
  countsOffDays    Boolean         @default(true)
  halfDayAllowed   Boolean         @default(false)
  needsCertificate Boolean         @default(false)
  /// Only on a day in the restricted-holiday list.
  restrictedOnly   Boolean         @default(false)
  /// "F" or "M" when the leave is for one gender only.
  gender           String?
  employeeTypes    EmployeeType[]
  /// The reporting officer may sanction up to this many days; beyond that (or when null) an Admin decides.
  officerLimitDays Int?
  sortOrder        Int             @default(0)
  isActive         Boolean         @default(true)
  version          Int             @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([boardId, code])
}

enum LeaveEntryKind {
  OPENING
  CREDIT
  DEBIT
  LAPSE
  REVERSAL
}

/// Leave account (LV-07): every credit and debit; the balance is the sum.
model LeaveLedger {
  id            String         @id @default(cuid())
  boardId       String
  employeeId    String
  leaveCode     String
  date          DateTime       @db.Date
  kind          LeaveEntryKind
  days          Decimal        @db.Decimal(6, 1)
  /// Credit or lapse period ("2026-H2", "2026", "lapse-2025"); one per person, leave and period.
  period        String?
  applicationId String?
  note          String?
  createdById   String?
  createdAt     DateTime       @default(now())

  @@unique([employeeId, leaveCode, period])
  @@index([employeeId, leaveCode])
  @@index([boardId, date])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

model LeaveApplication {
  id               String      @id @default(cuid())
  boardId          String
  employeeId       String
  leaveCode        String
  fromDate         DateTime    @db.Date
  toDate           DateTime    @db.Date
  halfDay          Boolean     @default(false)
  /// Days of leave counted under the type's rules.
  days             Decimal     @db.Decimal(6, 1)
  /// The balance it is taken from, and how many days (commuted: HPL × 2).
  debitCode        String
  debitDays        Decimal     @db.Decimal(6, 1)
  reason           String
  contact          String?
  attachmentKey    String?
  attachmentName   String?
  attachmentSha256 String?
  status           LeaveStatus @default(PENDING)
  taskId           String?
  /// Entered by HR for someone who does not use the system (LV-05), with the paper sanction.
  onBehalf         Boolean     @default(false)
  sanctionRef      String?
  createdById      String
  decidedAt        DateTime?
  cancelledAt      DateTime?
  cancelNote       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([employeeId, fromDate])
  @@index([boardId, status])
}

// ─── Module 6: rates and rules, monthly payroll (PRD §8) ──────────────────────────

/// A pay matrix in force from a date (PR-01): levels → cells, e.g. { "6": [35400, 36500, …] }.
model PayMatrix {
  id            String   @id @default(cuid())
  boardId       String
  name          String
  effectiveFrom DateTime @db.Date
  levels        Json
  createdById   String?
  createdAt     DateTime @default(now())

  @@unique([boardId, effectiveFrom])
}

/// Dated rates (PR-02, ST-01): DA %, HRA %, TA by tier, NPS, GPF, GIS, EPF, ESIC… The rate for a month is the latest
/// row on or before the month's first day; a new row with a past date is how arrears start (PR-08).
model PayRate {
  id            String   @id @default(cuid())
  boardId       String
  key           String
  value         Decimal  @db.Decimal(14, 4)
  effectiveFrom DateTime @db.Date
  note          String?
  createdById   String?
  createdAt     DateTime @default(now())

  @@unique([boardId, key, effectiveFrom])
  @@index([boardId, key])
}

enum PayHeadKind {
  EARNING
  DEDUCTION
  EMPLOYER
}

/// SYSTEM: worked out by the pay engine (Basic, DA, HRA, TA, NPS…). FIXED: rupees a month for the listed posts.
/// PERCENT_BASIC: a percentage of Basic for the listed posts (NPA). ITEM: only through an employee pay item.
enum PayHeadCalc {
  SYSTEM
  FIXED
  PERCENT_BASIC
  ITEM
}

/// Pay heads master (PR-03, PR-04): every earning, deduction and employer share with its formula and account head.
model PayHead {
  id          String      @id @default(cuid())
  boardId     String
  code        String
  name        String
  nameHi      String
  kind        PayHeadKind
  calc        PayHeadCalc
  /// Rupees for FIXED, percent for PERCENT_BASIC.
  value       Decimal     @default(0) @db.Decimal(12, 2)
  postCodes   String[]
  /// Reduced for days not paid (most earnings); fixed deductions are not.
  prorate     Boolean     @default(true)
  /// Counts as pay for DA and NPS (NPA).
  countsForDa Boolean     @default(false)
  taxable     Boolean     @default(true)
  /// e-Chhawani account head (PR-14).
  accountHead String
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  version     Int         @default(1)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([boardId, code])
}

/// A standing allowance or deduction for one person (licence fee, society dues, GPF subscription, TDS…).
model EmployeePayItem {
  id          String   @id @default(cuid())
  boardId     String
  employeeId  String
  headCode    String
  amount      Decimal  @db.Decimal(12, 2)
  /// "YYYY-MM"
  fromMonth   String
  toMonth     String?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([boardId, headCode])
}

/// PR-05 pay groups.
enum PayGroup {
  OPS
  NPS
  CONTRACT
  PENSION
}

/// S-40: Run → Fix exceptions (DRAFT) → Check (CHECKING) → Approve and sign (APPROVING → APPROVED) → Pay (PAID) → CLOSED.
enum PayrollStatus {
  DRAFT
  CHECKING
  APPROVING
  APPROVED
  PAID
  CLOSED
}

/// REGULAR: the month's pay bill. SUPPLEMENTARY: arrears, pay withheld earlier, or a joiner's missed month (PR-08, S-42).
enum RunKind {
  REGULAR
  SUPPLEMENTARY
}

model PayrollRun {
  id             String        @id @default(cuid())
  boardId        String
  payGroup       PayGroup
  /// "YYYY-MM"
  month          String
  kind           RunKind       @default(REGULAR)
  /// 0 for the regular bill; 1, 2… for that month's supplementary bills.
  seq            Int           @default(0)
  title          String?
  /// What a supplementary bill pays: { type: "ARREARS" | "WITHHELD" | "JOINER", … } — kept so it can be worked out again.
  source         Json?
  status         PayrollStatus @default(DRAFT)
  /// How many times the run was worked out again.
  version        Int           @default(1)
  runById        String
  runByName      String
  runAt          DateTime
  employees      Int           @default(0)
  gross          Decimal       @default(0) @db.Decimal(14, 2)
  deductions     Decimal       @default(0) @db.Decimal(14, 2)
  net            Decimal       @default(0) @db.Decimal(14, 2)
  employer       Decimal       @default(0) @db.Decimal(14, 2)
  submittedAt    DateTime?
  checkedById    String?
  checkedByName  String?
  approvedById   String?
  approvedByName String?
  approvedAt     DateTime?
  bankFileId     String?
  paidAt         DateTime?
  /// When the bank's return file (failed credits) was read, or "all credited" was recorded.
  returnAt       DateTime?
  /// PR-14 accounting summary built at month close.
  summaryFileId  String?
  /// SL-04: when payslip notices (SMS link and email) went out.
  payslipsSentAt DateTime?
  closedAt       DateTime?
  reopenedAt     DateTime?
  reopenNote     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payslips   Payslip[]
  exceptions PayrollException[]

  @@unique([boardId, payGroup, month, kind, seq])
}

enum PayslipStatus {
  INCLUDED
  WITHHELD
}

enum CreditStatus {
  CREDITED
  FAILED
  REPAID
}

/// One person's pay in a run: every head as a line, totals, and how the days were worked out.
model Payslip {
  id             String        @id @default(cuid())
  boardId        String
  runId          String
  employeeId     String
  month          String
  payGroup       PayGroup
  sectionId      String
  postId         String
  payLevel       String?
  payCell        Int?
  status         PayslipStatus @default(INCLUDED)
  withheldReason String?
  daysInMonth    Int
  daysOnRoll     Decimal       @db.Decimal(5, 1)
  /// Dies-non and leave on no pay from last month's locked attendance (D-17), and leave on half pay.
  lossDays       Decimal       @default(0) @db.Decimal(5, 1)
  halfPayDays    Decimal       @default(0) @db.Decimal(5, 1)
  workedDays     Decimal?      @db.Decimal(5, 1)
  /// [{ code, name, nameHi, kind, amount, accountHead, note }]
  lines          Json
  gross          Decimal       @db.Decimal(12, 2)
  deductions     Decimal       @db.Decimal(12, 2)
  net            Decimal       @db.Decimal(12, 2)
  employer       Decimal       @db.Decimal(12, 2)
  bankLast4      String?
  ifsc           String?
  lastNet        Decimal?      @db.Decimal(12, 2)
  changePct      Decimal?      @db.Decimal(8, 2)
  creditStatus   CreditStatus?
  creditNote     String?
  /// The re-pay bank file for a failed credit (PR-12).
  repayFileId    String?
  /// Month-by-month arrears (due vs drawn) for a supplementary bill, and the loan instalments in a regular one.
  detail         Json?
  /// SL-04: when the payslip notice was sent.
  sentAt         DateTime?
  /// Pension slips (PN-02): the pension paid — the slip's employee is the one whose service earned it.
  pensionerId    String?
  createdAt      DateTime      @default(now())

  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id])

  @@unique([runId, employeeId])
  @@index([employeeId, month])
  @@index([pensionerId])
}

enum ExceptionSeverity {
  BLOCK
  WARN
}

enum ExceptionResolution {
  EXPLAINED
  WITHHELD
  WAIVED
}

/// PR-10 pre-checks. Blocking ones must be fixed (or the pay withheld) before the Checker sees the run;
/// warnings need a remark the Checker reads.
model PayrollException {
  id             String               @id @default(cuid())
  runId          String
  employeeId     String?
  code           String
  severity       ExceptionSeverity
  vars           Json?
  resolution     ExceptionResolution?
  note           String?
  resolvedById   String?
  resolvedByName String?
  resolvedAt     DateTime?
  createdAt      DateTime             @default(now())

  run PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

// ─── Module 7: pay changes, arrears, loans and salary slips (PRD §8) ───────────────

enum PayChangeReason {
  INITIAL
  INCREMENT
  PROMOTION
  MACP
  CORRECTION
}

/// Pay level and cell from a date (PR-06, PR-07). The payroll reads the row in force on a month's 1st and arrears compare
/// it with what was drawn. A row dated in the future waits; `applied` is set once the employee record shows it.
model PayHistory {
  id             String          @id @default(cuid())
  boardId        String
  employeeId     String
  effectiveFrom  DateTime        @db.Date
  payLevel       String
  payCell        Int
  postId         String?
  reason         PayChangeReason
  /// For a fixation: the rule used and the figures the Checker saw.
  details        Json?
  serviceEntryId String?
  applied        Boolean         @default(false)
  createdById    String?
  createdAt      DateTime        @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
  @@index([boardId, reason, effectiveFrom])
}

enum LoanType {
  HBA
  VEHICLE
  COMPUTER
  FESTIVAL
  OTHER
}

enum LoanStatus {
  PENDING
  RUNNING
  CLOSED
  REJECTED
}

/// PR-09: a loan or advance — principal first in equal instalments, then the simple interest; recovery stops at zero.
model Loan {
  id               String     @id @default(cuid())
  boardId          String
  employeeId       String
  type             LoanType
  purpose          String?
  principal        Decimal    @db.Decimal(12, 2)
  /// Simple interest, % a year, on the principal still due each month; 0 for interest-free advances.
  interestRate     Decimal    @default(0) @db.Decimal(6, 3)
  instalments      Int
  instalmentAmount Decimal    @db.Decimal(12, 2)
  sanctionDate     DateTime   @db.Date
  orderNumber      String?
  /// "YYYY-MM": the first month an instalment is recovered.
  startMonth       String
  status           LoanStatus @default(PENDING)
  closedMonth      String?
  /// Interest already owed on a loan brought from the old system (recovered after the principal, like the rest).
  openingInterest  Decimal    @default(0) @db.Decimal(12, 2)
  createdById      String
  createdByName    String
  createdAt        DateTime   @default(now())

  employee   Employee       @relation(fields: [employeeId], references: [id])
  recoveries LoanRecovery[]

  @@index([employeeId])
  @@index([boardId, status])
}

/// An instalment recovered through an approved payroll; removed again if that payroll is reopened (PR-13).
model LoanRecovery {
  id        String   @id @default(cuid())
  loanId    String
  runId     String
  month     String
  principal Decimal  @db.Decimal(12, 2)
  interest  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, runId])
  @@index([runId])
}

// ─── Module 8: statutory and tax (PRD §9) ─────────────────────────────────────────

enum GpfEntryKind {
  OPENING
  SUBSCRIPTION
  REFUND
  ADVANCE
  WITHDRAWAL
  INTEREST
}

/// GPF account (§9): every credit and debit; the balance is the sum. Subscriptions and refunds come from approved pay bills.
model GpfEntry {
  id          String       @id @default(cuid())
  boardId     String
  employeeId  String
  /// "YYYY-MM" the entry belongs to.
  month       String
  /// "2026-27"
  fy          String
  kind        GpfEntryKind
  /// Credit positive, debit negative.
  amount      Decimal      @db.Decimal(12, 2)
  runId       String?
  /// The advance or withdrawal this entry pays out or recovers.
  advanceId   String?
  note        String?
  createdById String?
  createdAt   DateTime     @default(now())

  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  advance  GpfAdvance? @relation(fields: [advanceId], references: [id])

  @@index([employeeId, month])
  @@index([runId])
}

enum GpfAdvanceKind {
  ADVANCE
  WITHDRAWAL
}

enum GpfAdvanceStatus {
  PENDING
  RUNNING
  CLOSED
  REJECTED
}

/// GPF advance (paid back in instalments through the payroll) or final withdrawal (not paid back). Payroll sanctions,
/// a Checker checks, an Admin approves.
model GpfAdvance {
  id               String           @id @default(cuid())
  boardId          String
  employeeId       String
  kind             GpfAdvanceKind
  purpose          String
  amount           Decimal          @db.Decimal(12, 2)
  /// 0 for a withdrawal.
  instalments      Int              @default(0)
  instalmentAmount Decimal          @default(0) @db.Decimal(12, 2)
  sanctionDate     DateTime         @db.Date
  orderNumber      String
  /// First month of recovery ("YYYY-MM") — the month after the advance is approved.
  startMonth       String?
  status           GpfAdvanceStatus @default(PENDING)
  closedMonth      String?
  createdById      String
  createdByName    String
  createdAt        DateTime         @default(now())

  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  entries  GpfEntry[]

  @@index([employeeId, status])
}

/// ST-01: income-tax rules for a financial year and regime — slabs, standard deduction, rebate, cess. Editable through an Admin.
model TaxRule {
  id                String   @id @default(cuid())
  boardId           String
  fy                String
  regime            String
  /// [{ upTo: number | null, rate: number }] — rupees, % — upTo null is "above".
  slabs             Json
  standardDeduction Decimal  @db.Decimal(12, 2)
  rebateIncomeLimit Decimal  @db.Decimal(14, 2)
  rebateMax         Decimal  @db.Decimal(12, 2)
  cessPercent       Decimal  @db.Decimal(5, 2)
  version           Int      @default(1)
  updatedAt         DateTime @updatedAt

  @@unique([boardId, fy, regime])
}

enum DeclarationStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  RETURNED
}

/// ST-02, ST-03: the regime chosen for a year and the investments declared, with proofs; verified by HR & Accounts.
model TaxDeclaration {
  id           String            @id @default(cuid())
  boardId      String
  employeeId   String
  fy           String
  regime       String            @default("NEW")
  /// { sec80C, sec80D, sec80CCD1B, homeLoanInterest, rentPaid, otherIncome } in rupees (old regime deductions).
  items        Json
  /// Stored proof files: [{ key, name, size, sha256 }]
  proofs       Json?
  status       DeclarationStatus @default(DRAFT)
  remarks      String?
  submittedAt  DateTime?
  verifiedById String?
  verifiedAt   DateTime?
  updatedAt    DateTime          @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, fy])
}

/// ST-04: salary and TDS of the year paid outside this system — by the old system before cut-over (§15) or by a previous
/// employer (Form 12B) — counted in the year's projection and in Form 16.
model TaxCarryIn {
  id          String   @id @default(cuid())
  boardId     String
  employeeId  String
  fy          String
  salary      Decimal  @db.Decimal(14, 2)
  tds         Decimal  @db.Decimal(14, 2)
  note        String
  createdById String
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, fy])
}

/// ST-05: a TDS challan deposited for a month.
model TdsChallan {
  id          String   @id @default(cuid())
  boardId     String
  fy          String
  month       String
  bsrCode     String
  challanNo   String
  depositedOn DateTime @db.Date
  tax         Decimal  @db.Decimal(14, 2)
  cess        Decimal  @db.Decimal(14, 2)
  interest    Decimal  @default(0) @db.Decimal(14, 2)
  createdById String
  createdAt   DateTime @default(now())

  @@unique([boardId, month, challanNo])
}

/// ST-07: Form 16 for a person and year — Part B generated here, Part A imported from TRACES; published to the employee.
model Form16 {
  id          String    @id @default(cuid())
  boardId     String
  employeeId  String
  fy          String
  partBKey    String?
  partBSha    String?
  partAKey    String?
  partASha    String?
  /// The year's tax working printed on Part B (taxWorking) plus TDS deducted.
  working     Json?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, fy])
}

/// ST-01, ST-08: when each filing is due. MONTHLY: the day of the next month; QUARTERLY / YEARLY: listed "MM-DD" dates;
/// AFTER_PAY: days after the pay bill is approved.
model DueRule {
  id        String   @id @default(cuid())
  boardId   String
  code      String
  name      String
  nameHi    String
  kind      String
  day       Int      @default(0)
  dates     String[]
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([boardId, code])
}

/// ST-08: a reminder sent for a due date (once).
model DueReminder {
  id      String   @id @default(cuid())
  boardId String
  code    String
  dueOn   DateTime @db.Date
  sentAt  DateTime @default(now())

  @@unique([boardId, code, dueOn])
}

// ─── Module 9: pension (PRD §10) ──────────────────────────────────────────────────

enum PensionType {
  SUPERANNUATION
  VOLUNTARY
  INVALID
  COMPULSORY
  FAMILY
}

enum PensionerStatus {
  ACTIVE
  STOPPED
}

/// PN-01: a pension being paid — to the retired employee (relation SELF) or, after a death, to a family member. It always
/// belongs to the employee whose service earned it; family pensioners and pensioners brought from the old system have
/// no employee record of their own (the retired employee's record is kept with status RETIRED or DECEASED).
model Pensioner {
  id                 String          @id @default(cuid())
  boardId            String
  employeeId         String
  ppoNumber          String
  type               PensionType
  status             PensionerStatus @default(ACTIVE)
  /// SELF, SPOUSE, SON, DAUGHTER, MOTHER, FATHER …
  relation           String          @default("SELF")
  payeeName          String
  payeeNameHi        String?
  payeeDob           DateTime        @db.Date
  mobile             String?
  email              String?
  /// Monthly basic pension or family pension, rupees.
  basicPension       Decimal         @db.Decimal(12, 2)
  /// Family pension at the enhanced rate until `reducedFrom`, then this amount.
  reducedPension     Decimal?        @db.Decimal(12, 2)
  reducedFrom        DateTime?       @db.Date
  /// Monthly pension commuted; recovered until restored 15 years after commutation (PN-03).
  commutedAmount     Decimal         @default(0) @db.Decimal(12, 2)
  commutationDate    DateTime?       @db.Date
  commutationLumpSum Decimal?        @db.Decimal(14, 2)
  /// Fixed medical allowance (not for those who use CGHS).
  fmaEligible        Boolean         @default(true)
  startDate          DateTime        @db.Date
  endDate            DateTime?       @db.Date
  endReason          String?
  /// After a death: what approved bills paid for days after it, by month and head (being recovered) — so later arrears
  /// for those months count only what was due (PN-05, PN-11).
  endDetail          Json?
  bankAccountEnc     String?
  bankAccountHash    String?
  bankAccountLast4   String?
  ifsc               String?
  bankName           String?
  /// The pension this one follows (family pension after the pensioner's death).
  previousId         String?
  caseId             String?
  createdById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  employee         Employee            @relation(fields: [employeeId], references: [id])
  lifeCertificates LifeCertificate[]
  users            User[]
  verification     RecordVerification?

  @@unique([boardId, ppoNumber])
  @@index([employeeId])
}

enum LifeCertificateSource {
  MANUAL
  JEEVAN_PRAMAAN
}

enum LifeCertificateStatus {
  SUBMITTED
  VERIFIED
  REJECTED
}

/// PN-06: a life certificate — entered by HR & Accounts (Pension), or a Jeevan Pramaan certificate uploaded by the
/// pensioner and verified by Pension.
model LifeCertificate {
  id           String                @id @default(cuid())
  boardId      String
  pensionerId  String
  source       LifeCertificateSource
  status       LifeCertificateStatus @default(VERIFIED)
  /// The date the certificate was given (on the certificate).
  certifiedOn  DateTime              @db.Date
  /// Jeevan Pramaan ID, when it came from there.
  jpId         String?
  fileKey      String?
  fileSha      String?
  fileName     String?
  note         String?
  enteredById  String
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime              @default(now())

  pensioner Pensioner @relation(fields: [pensionerId], references: [id], onDelete: Cascade)

  @@index([pensionerId, certifiedOn])
}

enum PensionCaseStatus {
  DRAFT
  CHECKING
  APPROVING
  APPROVED
  REJECTED
}

/// PN-08, PN-09: a new pension case — the calculator's inputs and working, checked by a Checker and approved by an Admin,
/// then the PPO. For a death in service (type FAMILY) the retirement date is the date of death.
model PensionCase {
  id             String            @id @default(cuid())
  boardId        String
  employeeId     String
  type           PensionType
  retirementDate DateTime          @db.Date
  /// Commutation %, non-qualifying days, family pensioner, bank … as entered.
  inputs         Json
  /// Qualifying service, emoluments, pension, commutation, gratuity, leave encashment, GPF, family pension.
  working        Json
  status         PensionCaseStatus @default(DRAFT)
  ppoNumber      String?
  ppoKey         String?
  ppoSha         String?
  pensionerId    String?
  benefitsRunId  String?
  createdById    String
  createdByName  String
  approvedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  employee Employee     @relation(fields: [employeeId], references: [id])
  noDues   NoDuesItem[]

  @@index([employeeId])
}

/// PN-07: each section's no-dues for a retirement.
model NoDuesItem {
  id        String    @id @default(cuid())
  caseId    String
  sectionId String
  /// PENDING, CLEAR or DUES
  status    String    @default("PENDING")
  amount    Decimal   @default(0) @db.Decimal(12, 2)
  note      String?
  byId      String?
  byName    String?
  at        DateTime?

  case PensionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, sectionId])
}

/// Dated rule tables that are more than one rate — the commutation factors by age (PN-08). Editable through an Admin.
model RuleTable {
  id            String   @id @default(cuid())
  boardId       String
  code          String
  effectiveFrom DateTime @db.Date
  data          Json
  note          String?
  createdById   String?
  createdAt     DateTime @default(now())

  @@unique([boardId, code, effectiveFrom])
}

// ─── Module 10: FoxPro migration (PRD §15, S-90) ─────────────────────────────────

/// A file from the old system kept exactly as uploaded, with its checksum (§15 step 1). Tables (.DBF, CSV, Excel) are
/// also staged row by row (step 3); memo, index and program files are kept frozen only.
model MigrationFile {
  id             String   @id @default(cuid())
  boardId        String
  fileName       String
  /// DBF, CSV, XLSX — staged; FPT, CDX, PRG and anything else — frozen only.
  kind           String
  size           Int
  sha256         String
  storageKey     String
  /// The staged table's name: the file name without its extension, in capitals.
  tableName      String?
  /// Records the file itself says it holds (the DBF header count; rows for CSV and Excel).
  sourceCount    Int?
  liveCount      Int      @default(0)
  deletedCount   Int      @default(0)
  /// [{ name, type, length, decimals }]
  columns        Json?
  /// Memo file read with the table, and memos it could not find.
  memoFileId     String?
  missingMemos   Int      @default(0)
  /// A newer upload of the same table replaces this one in the mapping.
  replaced       Boolean  @default(false)
  uploadedById   String
  uploadedByName String
  createdAt      DateTime @default(now())

  rows MigrationRow[]

  @@index([boardId, tableName])
}

/// One staged row. `data` stays as read; cleaning (§15 step 5) writes `fixed`, value by value.
model MigrationRow {
  id        String    @id @default(cuid())
  fileId    String
  rowNo     Int
  deleted   Boolean   @default(false)
  data      Json
  fixed     Json?
  fixedById String?
  fixedAt   DateTime?

  file MigrationFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, rowNo])
  @@index([fileId, deleted])
}

/// §15 step 4: how one staged table becomes records here — field by field, with code lists (pay codes, sections, posts,
/// types). Signed off by Accounts; any change clears the sign-off.
model MigrationMapping {
  id           String    @id @default(cuid())
  boardId      String
  target       String
  fileId       String?
  /// { field: { column, transform } }
  fields       Json
  /// { list: { oldValue: newValue } }
  codes        Json?
  /// Values for the whole load (as-on date, financial year, control totals).
  options      Json?
  signedById   String?
  signedByName String?
  signedAt     DateTime?
  updatedById  String
  updatedAt    DateTime  @updatedAt

  @@unique([boardId, target])
}

/// A flagged row explained in writing instead of fixed (§15 "Exceptions").
model MigrationNote {
  id        String   @id @default(cuid())
  boardId   String
  /// target:fileId:rowNo:code
  key       String
  note      String
  byId      String
  byName    String
  createdAt DateTime @default(now())

  @@unique([boardId, key])
}

/// A §15 check signed by one of the people the PRD names, with the figures they saw.
model MigrationSignoff {
  id         String     @id @default(cuid())
  boardId    String
  check      String
  permission Permission
  userId     String
  userName   String
  result     Json
  createdAt  DateTime   @default(now())

  @@unique([boardId, check, permission])
}

/// §15 step 7: a record compared with the paper service book by HR, confirmed by the person (online or on a signed
/// sheet) and then locked by a Checker. One row per employee or per pension.
model RecordVerification {
  id                String    @id @default(cuid())
  boardId           String
  employeeId        String?   @unique
  pensionerId       String?   @unique
  serviceBookById   String?
  serviceBookByName String?
  serviceBookAt     DateTime?
  /// SELF (online) or SHEET (a printed sheet signed by the person, entered by HR).
  confirmedVia      String?
  confirmedByName   String?
  confirmedAt       DateTime?
  /// What the person said was wrong (sent on as a change request).
  problem           String?
  lockedById        String?
  lockedByName      String?
  lockedAt          DateTime?
  updatedAt         DateTime  @updatedAt

  employee  Employee?  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  pensioner Pensioner? @relation(fields: [pensionerId], references: [id], onDelete: Cascade)

  @@index([boardId])
}

/// §15 step 9: one month of the parallel run — FoxPro's pay sheet against the bills here.
model ParallelRun {
  id            String   @id @default(cuid())
  boardId       String
  month         String
  fileId        String
  people        Int
  heads         Int
  matched       Int
  createdById   String
  createdByName String
  createdAt     DateTime @default(now())

  diffs ParallelDiff[]

  @@unique([boardId, month])
}

/// A difference over ₹1 for one person and head; each one is explained before the next month (§15 step 9).
model ParallelDiff {
  id              String    @id @default(cuid())
  runId           String
  employeeCode    String
  employeeId      String?
  name            String?
  head            String
  fox             Decimal   @db.Decimal(12, 2)
  ours            Decimal   @db.Decimal(12, 2)
  note            String?
  explainedById   String?
  explainedByName String?
  explainedAt     DateTime?

  run ParallelRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}
