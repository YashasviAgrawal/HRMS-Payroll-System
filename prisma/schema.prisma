// DCB HRMS & Payroll — database schema.
// Every business table carries boardId so other Cantonment Boards can be added later (PRD §16, §17).
// Module 1 (foundation) tables live at the top; each later module adds its own block below.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Module 1 — Foundation
// ─────────────────────────────────────────────────────────────────────────────

/// The three logins of PRD §2.
enum LoginType {
  ADMIN
  HR_ACCOUNTS
  EMPLOYEE
}

/// Permissions an Admin can tick inside a login (PRD §2).
enum Permission {
  APPROVER
  PAY_BILL_SIGNER
  USER_SETTINGS_MANAGER
  HR
  PAYROLL
  PENSION
  CHECKER
  REPORTING_OFFICER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model Board {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  nameHi    String
  address   String?
  createdAt DateTime @default(now())

  sections Section[]
  posts    Post[]
  users    User[]
}

model Section {
  id        String   @id @default(cuid())
  boardId   String
  code      String
  name      String
  nameHi    String
  isActive  Boolean  @default(true)
  /// DEVICE = biometric punches (AT-01); MANUAL = muster entered by HR (AT-02).
  attendanceMode AttendanceMode @default(DEVICE)
  /// Weekly off days as "0,6" (0 = Sunday … 6 = Saturday). Null follows the Board setting.
  weeklyOff      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board     Board      @relation(fields: [boardId], references: [id])
  employees Employee[]

  @@unique([boardId, code])
}

/// A post (designation) such as "Junior Clerk". Retirement age follows the post's rule (EM-02).
model Post {
  id            String   @id @default(cuid())
  boardId       String
  code          String
  name          String
  nameHi        String
  payLevel      String
  group         String // A, B or C
  retirementAge Int      @default(60)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  board     Board      @relation(fields: [boardId], references: [id])
  employees Employee[]

  @@unique([boardId, code])
}

enum EmployeeType {
  PERMANENT_OPS
  PERMANENT_NPS
  CONTRACT
  DAILY_WAGE
  REEMPLOYED
  DEPUTATION
}

enum EmployeeStatus {
  /// Entered by HR, waiting for the Checker; gets its Employee ID on approval.
  DRAFT
  ACTIVE
  SUSPENDED
  RETIRED
  RESIGNED
  TRANSFERRED
  TERMINATED
  DECEASED
}

/// One record per person (EM-01). Every other module reads from it.
model Employee {
  id               String         @id @default(cuid())
  boardId          String
  /// Null while the record is a draft; issued when the Checker approves (RO flow step 4).
  employeeCode     String?
  type             EmployeeType
  status           EmployeeStatus @default(ACTIVE)
  firstName        String
  middleName       String?
  lastName         String?
  nameHi           String?
  gender           String // M, F, T
  dateOfBirth      DateTime       @db.Date
  dateOfJoining    DateTime       @db.Date
  dateOfRetirement DateTime?      @db.Date
  /// Set when the person leaves for any reason; access ends on this date (PRD §2 rule 6).
  exitDate         DateTime?      @db.Date
  exitReason       String?
  sectionId        String
  postId           String
  payLevel         String?
  payCell          Int?
  mobile           String?
  email            String?

  // Personal (Personal tab)
  fatherOrSpouseName String?
  category           String? // GEN, OBC, SC, ST, EWS
  maritalStatus      String? // SINGLE, MARRIED, WIDOWED, DIVORCED
  bloodGroup         String?
  isDisabled         Boolean  @default(false)
  /// { line1, line2, city, district, state, pincode } — state and district follow government code lists (PRD §12 rule 6).
  presentAddress     Json?
  permanentAddress   Json?

  // Identity and bank (EM-03). Aadhaar, PAN and bank account are encrypted; *Hash finds duplicates; *Last4 is for display.
  panEnc             String?
  panHash            String?
  panLast4           String?
  aadhaarEnc         String?
  aadhaarHash        String?
  aadhaarLast4       String?
  pran               String?
  uan                String?
  esicNumber         String?
  gpfNumber          String?
  bankAccountEnc     String?
  bankAccountHash    String?
  bankAccountLast4   String?
  ifsc               String?
  bankName           String?
  bankBranch         String?

  // Probation and confirmation (RO-08)
  probationEndDate   DateTime? @db.Date
  confirmationDate   DateTime? @db.Date

  /// Enrolment number on the biometric devices / AEBAS attendance ID (AT-01).
  biometricId        String?

  // Contract and daily-wage workers (RO-09)
  agencyName         String?
  wageRate           Decimal?  @db.Decimal(12, 2)
  wageBasis          String? // MONTHLY or DAILY
  contractStart      DateTime? @db.Date
  contractEnd        DateTime? @db.Date

  createdById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  section     Section                @relation(fields: [sectionId], references: [id])
  post        Post                   @relation(fields: [postId], references: [id])
  users       User[]
  family      FamilyMember[]
  nominees    Nominee[]
  documents   EmployeeDocument[]
  serviceBook ServiceBookEntry[]
  history     EmployeeFieldHistory[]

  @@unique([boardId, employeeCode])
  @@unique([boardId, biometricId])
  @@index([boardId, sectionId])
  @@index([boardId, status])
  @@index([boardId, panHash])
  @@index([boardId, aadhaarHash])
  @@index([boardId, bankAccountHash])
}

/// A login. A person may hold one login of each type (for example an HR clerk also has an Employee login
/// for their own payslip), so the login type is part of the identity.
model User {
  id                 String       @id @default(cuid())
  boardId            String
  loginType          LoginType
  /// Employee ID for staff; a short code for people who are not on the rolls (for example "IT01").
  loginId            String
  displayName        String
  displayNameHi      String?
  mobile             String
  email              String?
  passwordHash       String?
  mustChangePassword Boolean      @default(true)
  permissions        Permission[]
  status             UserStatus   @default(ACTIVE)
  language           String       @default("en")
  employeeId         String?
  failedLoginCount   Int          @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdById        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  board    Board          @relation(fields: [boardId], references: [id])
  employee Employee?      @relation(fields: [employeeId], references: [id])
  sessions Session[]
  otps     OtpChallenge[]

  @@unique([boardId, loginType, loginId])
  @@unique([boardId, loginType, mobile])
  @@unique([employeeId, loginType])
}

model Session {
  /// SHA-256 of the random token held in the cookie; the raw token is never stored.
  id         String    @id
  userId     String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum OtpPurpose {
  LOGIN
  CHANGE_MOBILE
  APPROVE_SIGN
}

model OtpChallenge {
  id          String     @id @default(cuid())
  userId      String?
  purpose     OtpPurpose
  codeHash    String
  sentTo      String
  context     Json?
  attempts    Int        @default(0)
  resendCount Int        @default(0)
  lastSentAt  DateTime   @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())
  ip          String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

enum AuditCategory {
  /// Logins, users, permissions and settings — the only events the User & settings manager may see.
  SYSTEM
  /// Employee, pay, leave and everything else.
  DATA
}

/// Every create, edit, approve and print with user, time, IP, old and new value (PRD §11, §16).
/// Rows cannot be updated or deleted: a database trigger blocks it.
model AuditLog {
  id          BigInt        @id @default(autoincrement())
  boardId     String
  at          DateTime      @default(now())
  userId      String?
  userName    String?
  loginType   LoginType?
  action      String
  entityType  String
  entityId    String?
  summary     String
  category    AuditCategory @default(DATA)
  isSensitive Boolean       @default(false)
  ip          String?
  userAgent   String?
  oldValue    Json?
  newValue    Json?

  @@index([boardId, at])
  @@index([boardId, entityType, entityId])
  @@index([boardId, userId])
}

/// Every approved change writes an event here so later systems can subscribe (PRD §12 rule 5).
model OutboxEvent {
  id            BigInt    @id @default(autoincrement())
  boardId       String
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)

  @@index([publishedAt, id])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

/// The maker-checker engine. One row per item waiting for a decision (S-04 Approvals inbox).
model ApprovalTask {
  id                 String         @id @default(cuid())
  boardId            String
  kind               String
  title              String
  titleHi            String?
  details            Json?
  payload            Json
  requiredPermission Permission
  /// Limits the task to reporting officers of this section.
  sectionId          String?
  /// Whose record, pay, loan or arrears this is; that person can never decide it (PRD §2 rule 2).
  subjectEmployeeId  String?
  entityType         String
  entityId           String?
  status             ApprovalStatus @default(PENDING)
  makerId            String
  makerName          String
  makerNote          String?
  deciderId          String?
  deciderName        String?
  decisionNote       String?
  decidedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([boardId, status, requiredPermission])
  @@index([boardId, entityType, entityId])
}

model Setting {
  boardId     String
  key         String
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@id([boardId, key])
}

/// Running numbers (Employee ID, order numbers…), allocated inside the same transaction as the record.
model Sequence {
  boardId String
  name    String
  next    Int    @default(1)

  @@id([boardId, name])
}

enum FileDirection {
  OUTGOING
  INCOMING
}

enum FileStatus {
  PREVIEW
  APPROVED
  REJECTED
  DOWNLOADED
  VALIDATED
  INVALID
  APPLIED
}

/// Every file the system builds or receives. Outgoing files are previewed, approved by an Admin and
/// logged with a checksum (PRD §12 rule 2, ST-09); incoming files are validated first (rule 3).
model FileRecord {
  id            String        @id @default(cuid())
  boardId       String
  direction     FileDirection
  kind          String
  period        String?
  fileName      String
  mimeType      String
  size          Int
  sha256        String
  storageKey    String
  status        FileStatus
  meta          Json?
  createdById   String
  createdByName String
  approvedById  String?
  approvedAt    DateTime?
  downloadCount Int           @default(0)
  lastDownloadAt DateTime?
  createdAt     DateTime      @default(now())

  @@index([boardId, kind, period])
}

enum MessageChannel {
  SMS
  EMAIL
}

model MessageLog {
  id          String         @id @default(cuid())
  boardId     String
  channel     MessageChannel
  recipient   String
  template    String
  /// Message text with any OTP replaced by ******.
  body        String
  status      String
  providerRef String?
  error       String?
  createdAt   DateTime       @default(now())

  @@index([boardId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Module 2 — Employee master
// ─────────────────────────────────────────────────────────────────────────────

model FamilyMember {
  id          String    @id @default(cuid())
  employeeId  String
  name        String
  nameHi      String?
  relation    String // SPOUSE, SON, DAUGHTER, FATHER, MOTHER, BROTHER, SISTER, OTHER
  gender      String?
  dateOfBirth DateTime? @db.Date
  isDependent Boolean   @default(false)
  isDisabled  Boolean   @default(false)
  isAlive     Boolean   @default(true)
  createdAt   DateTime  @default(now())

  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  nominees Nominee[]

  @@index([employeeId])
}

enum NomineeScheme {
  GPF
  GRATUITY
  GROUP_INSURANCE
  FAMILY_PENSION
  NPS
}

/// Nominees per scheme (EM-04). Shares of one scheme add up to 100%.
model Nominee {
  id             String        @id @default(cuid())
  employeeId     String
  scheme         NomineeScheme
  familyMemberId String
  sharePercent   Decimal       @db.Decimal(5, 2)
  createdAt      DateTime      @default(now())

  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  familyMember FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  @@index([employeeId, scheme])
}

/// Uploaded documents (EM-05): PDF or image, up to 5 MB, with checksum.
model EmployeeDocument {
  id             String    @id @default(cuid())
  employeeId     String
  category       String // APPOINTMENT_ORDER, CERTIFICATE, ID_PROOF, SERVICE_ORDER, MEDICAL, PHOTO, OTHER
  title          String
  fileName       String
  mimeType       String
  size           Int
  sha256         String
  storageKey     String
  uploadedById   String
  uploadedByName String
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

enum ServiceEvent {
  APPOINTMENT
  CONFIRMATION
  INCREMENT
  PROMOTION
  MACP
  PAY_FIXATION
  TRANSFER
  LEAVE
  PENALTY
  REWARD
  RETIREMENT
  OTHER
}

enum EntryStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Simple e-service book (EM-06): a dated list of events with order number, date and the attached order.
model ServiceBookEntry {
  id          String       @id @default(cuid())
  employeeId  String
  event       ServiceEvent
  eventDate   DateTime     @db.Date
  orderNumber String?
  orderDate   DateTime?    @db.Date
  details     String
  detailsHi   String?
  /// Structured data some events carry, e.g. { fromLevel, fromCell, toLevel, toCell } for an increment.
  data        Json?
  documentId  String?
  status      EntryStatus  @default(PENDING)
  createdById String
  approvedById String?
  createdAt   DateTime     @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, eventDate])
}

/// Old and new value of every approved change to an employee record ("keep their old value in history").
model EmployeeFieldHistory {
  id           String   @id @default(cuid())
  employeeId   String
  field        String
  /// Masked for Aadhaar, PAN and bank account.
  oldValue     String?
  newValue     String?
  isSensitive  Boolean  @default(false)
  changedById  String?
  changedBy    String?
  approvedById String?
  approvedBy   String?
  taskId       String?
  createdAt    DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt])
}

/// Sanctioned strength per section and post (EM-09). Filled = active employees on that post.
model SanctionedPost {
  id          String   @id @default(cuid())
  boardId     String
  sectionId   String
  postId      String
  sanctioned  Int
  orderRef    String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([boardId, sectionId, postId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Module 3 — Recruitment and onboarding
// ─────────────────────────────────────────────────────────────────────────────

enum VacancyStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ADVERTISED
  CLOSED
  CANCELLED
  REJECTED
}

enum SelectionStatus {
  OPEN
  PENDING_APPROVAL
  APPROVED
}

/// A vacancy is created only against a vacant sanctioned post and approved by an Admin before it is advertised (RO-01, RO-02).
model Vacancy {
  id              String          @id @default(cuid())
  boardId         String
  referenceNo     String
  sectionId       String
  postId          String
  payLevel        String
  seats           Int
  /// Reservation break-up { GEN, OBC, SC, ST, EWS } — seats per category (RO-02).
  reservation     Json
  advertNumber    String?
  advertDate      DateTime?       @db.Date
  lastDate        DateTime?       @db.Date
  status          VacancyStatus   @default(DRAFT)
  selectionStatus SelectionStatus @default(OPEN)
  notes           String?
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  applicants Applicant[]
  joinings   Joining[]

  @@unique([boardId, referenceNo])
  @@index([boardId, status])
}

enum ApplicantStatus {
  APPLIED
  ELIGIBLE
  SHORTLISTED
  SELECTED
  WAITLISTED
  REJECTED
}

/// RO-03: applicants added one by one or by Excel import. The exam or interview happens outside; only its result is recorded.
model Applicant {
  id                    String          @id @default(cuid())
  vacancyId             String
  applicationNo         String
  name                  String
  nameHi                String?
  fatherName            String?
  gender                String
  dateOfBirth           DateTime        @db.Date
  category              String
  mobile                String?
  email                 String?
  address               String?
  qualification         String?
  score                 Decimal?        @db.Decimal(7, 2)
  meritRank             Int?
  status                ApplicantStatus @default(APPLIED)
  remarks               String?
  appointmentLetterNo   String?
  appointmentLetterDate DateTime?       @db.Date
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  vacancy Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  joining Joining?

  @@unique([vacancyId, applicationNo])
  @@index([vacancyId, status])
}

enum JoiningStatus {
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  CANCELLED
}

/// RO-05/RO-06/RO-09: turns a selected candidate (or a contract / daily-wage worker hired directly) into an employee.
/// The person's record is a draft employee from the start; "Complete joining" sends it to the Checker.
model Joining {
  id          String        @id @default(cuid())
  boardId     String
  applicantId String?       @unique
  vacancyId   String?
  employeeId  String        @unique
  /// { documents, medical, police, oath, bank, pan, aadhaarConsent } → { done, documentId, note, by, at }
  checklist   Json
  status      JoiningStatus @default(IN_PROGRESS)
  createdById String
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  applicant Applicant? @relation(fields: [applicantId], references: [id])
  vacancy   Vacancy?   @relation(fields: [vacancyId], references: [id])

  @@index([boardId, status])
}

// ─── Module 4: attendance and holidays (PRD §6) ───────────────────────────────

enum AttendanceMode {
  DEVICE
  MANUAL
}

enum HolidayKind {
  GAZETTED
  RESTRICTED
}

/// Holiday calendar (AT-08). Rows exist only for lists a Checker has approved.
model Holiday {
  id        String      @id @default(cuid())
  boardId   String
  date      DateTime    @db.Date
  name      String
  nameHi    String
  kind      HolidayKind
  createdAt DateTime    @default(now())

  @@unique([boardId, date, name])
  @@index([boardId, date])
}

/// Daily status (AT-03). MISSED_PUNCH is provisional; DIES_NON is set only when the officer confirms (AT-05).
enum DayStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  MISSED_PUNCH
  ON_DUTY
  LEAVE
  HOLIDAY
  WEEKLY_OFF
  DIES_NON
}

enum DaySource {
  DEVICE
  MUSTER
  REQUEST
  LOCK
  LEAVE
}

/// One raw punch from a device push or an imported file. Duplicates are ignored by the unique key.
model AttendancePunch {
  id           String   @id @default(cuid())
  boardId      String
  employeeId   String
  at           DateTime
  deviceSerial String?
  importId     String?
  createdAt    DateTime @default(now())

  @@unique([employeeId, at])
  @@index([boardId, at])
}

/// A punch file that was saved (AT-01): who, when, which format, checksum of the stored copy.
model AttendanceImport {
  id             String   @id @default(cuid())
  boardId        String
  format         String
  fileName       String
  storageKey     String
  sha256         String
  rowCount       Int
  savedCount     Int
  duplicateCount Int
  fromDate       DateTime @db.Date
  toDate         DateTime @db.Date
  createdById    String
  createdByName  String
  createdAt      DateTime @default(now())

  @@index([boardId, createdAt])
}

/// The status of one person on one day. Days without a row are worked out from the calendar and punches.
model AttendanceDay {
  id            String    @id @default(cuid())
  boardId       String
  employeeId    String
  date          DateTime  @db.Date
  status        DayStatus
  firstIn       DateTime?
  lastOut       DateTime?
  workedMinutes Int?
  source        DaySource
  /// Leave type when status is LEAVE (filled by the Leave module).
  leaveCode     String?
  /// Half of the day only (half-day leave or half-day dies-non).
  half          Boolean   @default(false)
  note          String?
  /// Manual muster entries and HR corrections wait for a Checker (AT-02).
  checked       Boolean   @default(true)
  /// The leave application that marked this day (LV-04), so cancelling it can undo the day.
  applicationId String?
  updatedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([employeeId, date])
  @@index([boardId, date])
}

enum AttendanceRequestType {
  MISSED_PUNCH
  ON_DUTY
}

/// Missed-punch or on-duty request by an employee (AT-04), decided by the reporting officer.
model AttendanceRequest {
  id          String                @id @default(cuid())
  boardId     String
  employeeId  String
  date        DateTime              @db.Date
  type        AttendanceRequestType
  inTime      String?
  outTime     String?
  reason      String
  status      ApprovalStatus        @default(PENDING)
  taskId      String?
  createdById String
  decidedAt   DateTime?
  createdAt   DateTime              @default(now())

  @@index([boardId, status])
  @@index([employeeId, date])
}

/// A section's month, locked by its reporting officer or HR (AT-05). Payroll reads locked months only.
model AttendanceLock {
  id           String    @id @default(cuid())
  boardId      String
  sectionId    String
  /// "YYYY-MM"
  month        String
  lockedById   String
  lockedByName String
  lockedAt     DateTime  @default(now())
  unlockedAt   DateTime?
  unlockNote   String?

  @@unique([boardId, sectionId, month])
}

/// Month totals per person, frozen at lock; what payroll reads (AT-05, AT-06).
model AttendanceMonth {
  id          String   @id @default(cuid())
  boardId     String
  employeeId  String
  sectionId   String
  month       String
  daysInMonth Int
  daysOnRoll  Int
  present     Decimal  @db.Decimal(5, 1)
  late        Int
  halfDays    Int
  onDuty      Int
  leave       Decimal  @db.Decimal(5, 1)
  holidays    Int
  weeklyOffs  Int
  diesNon     Decimal  @db.Decimal(5, 1)
  /// Leave on half pay (HPL) and on no pay (EOL) in the month — payroll applies the pay effect (LV-04).
  halfPayLeave Decimal @default(0) @db.Decimal(5, 1)
  noPayLeave   Decimal @default(0) @db.Decimal(5, 1)
  /// Days paid for regular staff: days on the rolls less dies-non (and no-pay leave once the Leave module runs).
  payableDays Decimal  @db.Decimal(5, 1)
  /// Days actually worked — what contract and daily-wage workers are paid for (AT-06).
  workedDays  Decimal  @db.Decimal(5, 1)
  createdAt   DateTime @default(now())

  @@unique([employeeId, month])
  @@index([boardId, month])
}

// ─── Module 5: leave (PRD §7) ───────────────────────────────────────────────────

enum LeavePay {
  FULL
  HALF
  NONE
}

/// HALF_YEARLY: credited on 1 Jan and 1 Jul (EL, HPL). YEARLY: on 1 Jan (CL, RH). SPELL: up to creditDays per
/// spell (maternity, paternity). SERVICE: creditDays in the whole service (CCL). NONE: no balance (EOL, commuted).
enum LeaveCreditMode {
  HALF_YEARLY
  YEARLY
  SPELL
  SERVICE
  NONE
}

/// The leave rules table (LV-01). HR proposes a change, an Admin approves it.
model LeaveType {
  id               String          @id @default(cuid())
  boardId          String
  code             String
  name             String
  nameHi           String
  pay              LeavePay
  creditMode       LeaveCreditMode
  creditDays       Decimal         @default(0) @db.Decimal(6, 1)
  /// Highest balance allowed (EL 300).
  cap              Decimal?        @db.Decimal(6, 1)
  lapsesAtYearEnd  Boolean         @default(false)
  /// Commuted leave is taken from HPL at 2 days per day.
  debitFrom        String?
  debitFactor      Decimal         @default(1) @db.Decimal(3, 1)
  /// Holidays and weekly offs inside the leave are counted (EL, HPL…); not for CL.
  countsOffDays    Boolean         @default(true)
  halfDayAllowed   Boolean         @default(false)
  needsCertificate Boolean         @default(false)
  /// Only on a day in the restricted-holiday list.
  restrictedOnly   Boolean         @default(false)
  /// "F" or "M" when the leave is for one gender only.
  gender           String?
  employeeTypes    EmployeeType[]
  /// The reporting officer may sanction up to this many days; beyond that (or when null) an Admin decides.
  officerLimitDays Int?
  sortOrder        Int             @default(0)
  isActive         Boolean         @default(true)
  version          Int             @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([boardId, code])
}

enum LeaveEntryKind {
  OPENING
  CREDIT
  DEBIT
  LAPSE
  REVERSAL
}

/// Leave account (LV-07): every credit and debit; the balance is the sum.
model LeaveLedger {
  id            String         @id @default(cuid())
  boardId       String
  employeeId    String
  leaveCode     String
  date          DateTime       @db.Date
  kind          LeaveEntryKind
  days          Decimal        @db.Decimal(6, 1)
  /// Credit or lapse period ("2026-H2", "2026", "lapse-2025"); one per person, leave and period.
  period        String?
  applicationId String?
  note          String?
  createdById   String?
  createdAt     DateTime       @default(now())

  @@unique([employeeId, leaveCode, period])
  @@index([employeeId, leaveCode])
  @@index([boardId, date])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

model LeaveApplication {
  id               String      @id @default(cuid())
  boardId          String
  employeeId       String
  leaveCode        String
  fromDate         DateTime    @db.Date
  toDate           DateTime    @db.Date
  halfDay          Boolean     @default(false)
  /// Days of leave counted under the type's rules.
  days             Decimal     @db.Decimal(6, 1)
  /// The balance it is taken from, and how many days (commuted: HPL × 2).
  debitCode        String
  debitDays        Decimal     @db.Decimal(6, 1)
  reason           String
  contact          String?
  attachmentKey    String?
  attachmentName   String?
  attachmentSha256 String?
  status           LeaveStatus @default(PENDING)
  taskId           String?
  /// Entered by HR for someone who does not use the system (LV-05), with the paper sanction.
  onBehalf         Boolean     @default(false)
  sanctionRef      String?
  createdById      String
  decidedAt        DateTime?
  cancelledAt      DateTime?
  cancelNote       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([employeeId, fromDate])
  @@index([boardId, status])
}

